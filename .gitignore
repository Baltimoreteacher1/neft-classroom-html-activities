node_modules
dist
.DS_Store
*.log
# Ignore Claude Code local files (session history, logs, caches) by default,
# but keep the shared, version-controlled config tracked.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/

# Local tool caches / build state (never commit)
.wrangler/
.vite/
.playwright-mcp/
*.local
Thumbs.db
*.swp
*~

# Generated audit output and scratch space (regenerated by scripts; never commit)
#
# `reports/*`, not `reports/`: git does not descend into an excluded DIRECTORY,
# so with a trailing slash the negation below is silently impossible. Excluding
# the CONTENTS leaves the directory visible and makes the one exception work.
reports/*
# That exception is the a11y baseline, and it has to exist, because
# tools/a11y-ratchet.test.mjs reads the COMMITTED report by design — that is
# what makes the ratchet deterministic and fit for `npm test` rather than
# needing a browser. Ignoring it meant the report never persisted, so the
# ratchet could only pass on a machine that had just run the audit, and failed
# in CI every single time. Regenerate with:
#   npm run build && npx vite preview --port 4501 &
#   npm run audit:a11y -- --base http://localhost:4501
!reports/a11y-audit.md
tmp/

.codex/backups/

# Canvas / SCORM export packages (regenerated by tools/canvas + tools/scorm; never commit)
canvas-packages/
scorm-packages/

# Playwright smoke-test output
playwright-report/
test-results/
playwright-results.json

# Local brainstorm companion sessions (ephemeral mockups)
.superpowers/

# Canvas SCORM page packages are generated at build (prebuild chain) — not tracked
teacher-tools/canvas-scorm/packages/
teacher-tools/canvas-scorm/packages-index.json
.js-syntax-check.*.mjs
