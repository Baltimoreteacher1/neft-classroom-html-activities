{
  "$schema": "./config.schema.note",
  "timezone": "America/New_York",
  "scheduleHour": 2,
  "scheduleMinute": 0,
  "modules": {
    "regression-sentinel": true,
    "build-qa": true,
    "route-monitor": true,
    "divergence-watch": true,
    "backlog-advancer": true,
    "lesson-render": true,
    "backup-sentinel": true,
    "signal-health": true,
    "memory-index": true
  },
  "routeMonitor": {
    "manifest": "night-shift/route-manifest.json",
    "base": ""
  },
  "regressionSentinel": {
    "baselineRef": "stable-baseline-2026-06-04",
    "autoRestore": false,
    "shrinkPctThreshold": 35,
    "criticalFiles": [
      {
        "path": "curriculum/index.html",
        "requireMarkers": [
          "interactive-hub",
          "CurriculumHub"
        ]
      },
      {
        "path": "index.html",
        "requireMarkers": []
      },
      {
        "path": "_redirects",
        "requireMarkers": []
      },
      {
        "path": "data/routes.json",
        "requireMarkers": []
      }
    ]
  },
  "buildQa": {
    "runValidate": true,
    "runBuild": true,
    "playwrightSampleSize": 8
  },
  "divergenceWatch": {
    "remote": "origin",
    "mainBranch": "main",
    "autoFixStrayRefs": false
  },
  "backlogAdvancer": {
    "enabled": true,
    "enableClaudeTasks": false,
    "openPullRequests": true,
    "baseBranch": "main",
    "maxTasksPerRun": 1
  },
  "backupSentinel": {
    "warnAfterHours": 36,
    "failAfterHours": 72
  },
  "memoryIndex": {
    "limitBytes": 24400,
    "warnBytes": 19520,
    "targetBytes": 17100
  },
  "lessonRender": {
    "base": "",
    "all": true,
    "variants": true
  }
}
