<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.neft.route-monitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__REPO__/scripts/route-monitor.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Hourly. Live uptime + content-integrity check; cheaper than the nightly
       build QA, so it runs through the day to catch a bad deploy fast. -->
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/night-shift/briefings/route-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/night-shift/briefings/route-monitor.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
