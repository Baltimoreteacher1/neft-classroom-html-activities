[
  {
    "term": "numerator",
    "emoji": "⬆️",
    "def": "The top number of a fraction; it tells how many parts you have.",
    "example": "In <strong>2/3</strong>, the numerator is <strong>2</strong>."
  },
  {
    "term": "denominator",
    "emoji": "⬇️",
    "def": "The bottom number of a fraction; it tells how many equal parts the whole has.",
    "example": "In <strong>2/3</strong>, the denominator is <strong>3</strong>."
  },
  {
    "term": "multiply",
    "emoji": "✖️",
    "def": "To add the same number many times to find a total.",
    "example": "<strong>2 × 4</strong> means add 4 two times: 4 + 4 = <strong>8</strong>."
  },
  {
    "term": "equivalent fractions",
    "emoji": "🟰",
    "def": "Two fractions that name the same amount.",
