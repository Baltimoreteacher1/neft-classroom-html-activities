{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "package.json",
      "!!dist",
      "!!node_modules",
      "!!reports",
      "!!tmp",
      "!data/curriculum-search-index.json",
      "!**/package-lock.json",
      "!**/*.min.js",
      "!**/vendor/**",
      "!curriculum/monster-math-academy/assets/**",
      "!**/canvas-packages/**",
      "!**/*.bundle.js"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "globals": [
      "MiniSearch",
      "Phaser",
      "Confetti",
      "XLSX",
      "Chart",
      "ShiftData",
      "ShiftMatch",
      "ShiftGenerate",
      "renderPlaylistOptions",
      "switchGeneratorTab",
      "HEB",
      "EWL",
      "ACTIVITIES",
      "PRAYERS",
      "LISTENING_TYPES",
      "EduPulse",
      "JSZip",
      "google",
      "WebSocketPair",
      "__REACT_DEVTOOLS_GLOBAL_HOOK__"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off",
        "noUndeclaredVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "assets/**/*.js",
        "engine/**/*.js",
        "shared/**/*.js",
        "scripts/**",
        "tools/**",
        "functions/**/*.js",
        "workers/**/*.js",
        "vite.config.js",
        "package.json"
      ],
      "formatter": {
        "enabled": true
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "on"
          }
        }
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "warn",
            "noUnusedFunctionParameters": "warn"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}