{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "assets/**/*.js",
      "engine/**/*.js",
      "shared/**/*.js",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "tools/**/*.js",
      "tools/**/*.mjs",
      "functions/**/*.js",
      "workers/**/*.js",
      "vite.config.js",
      "package.json",
      "!!dist",
      "!!node_modules",
      "!!reports",
      "!!tmp",
      "!data/curriculum-search-index.json",
      "!**/package-lock.json",
      "!**/*.min.js",
      "!assets/vendor/**"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "globals": ["MiniSearch", "Phaser", "Confetti"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "noUndeclaredVariables": "error"
      }
    }
  }
}
