<!-- Projector modal -->
<div class="backdrop" id="backdrop">
  <div class="modal modal-projector" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" tabindex="-1">
    <div class="modal-head">
      <div>
        <span class="modal-badge" id="modalBadge">Lesson</span>
