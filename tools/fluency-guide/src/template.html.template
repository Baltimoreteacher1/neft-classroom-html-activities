          <button class="btn btn-ok" type="button" id="revealBtn" data-act="reveal" aria-expanded="false" aria-controls="modalAnswer">Reveal answer</button>
        </div>
        <div class="timer-track"><div class="timer-fill" id="timerFill"></div></div>
      </div>

      <!-- In-projector live room tally bar -->
      <div class="projector-tally-bar" id="projectorTallyBar">
        <span class="projector-tally-title">Quick Room Tally (Whiteboards):</span>
        <div class="projector-tally-group">
          <span class="projector-tally-pill secure">
            <button type="button" data-act="proj-tally" data-key="secure" data-delta="-1" aria-label="Decrease Secure count">−</button>
            <span id="projTallySecure">0</span> Secure
            <button type="button" data-act="proj-tally" data-key="secure" data-delta="1" aria-label="Increase Secure count">+</button>
          </span>
          <span class="projector-tally-pill dev">
            <button type="button" data-act="proj-tally" data-key="dev" data-delta="-1" aria-label="Decrease Developing count">−</button>
            <span id="projTallyDev">0</span> Developing
            <button type="button" data-act="proj-tally" data-key="dev" data-delta="1" aria-label="Increase Developing count">+</button>
          </span>
          <span class="projector-tally-pill not">
            <button type="button" data-act="proj-tally" data-key="not" data-delta="-1" aria-label="Decrease Not Yet count">−</button>
            <span id="projTallyNot">0</span> Not Yet
            <button type="button" data-act="proj-tally" data-key="not" data-delta="1" aria-label="Increase Not Yet count">+</button>
          </span>
          <button class="btn btn-sm" type="button" data-act="proj-tally-reset">Reset</button>
        </div>
      </div>

      <!-- In-projector inline math tools drawer -->
      <div class="projector-tools-drawer" id="projectorToolsDrawer">
        <div class="projector-tools-header">
          <div class="projector-tools-tabs" role="tablist">
            <button class="projector-tool-tab active" type="button" data-act="proj-tool-tab" data-ptab="fraction">Fraction Strips</button>
            <button class="projector-tool-tab" type="button" data-act="proj-tool-tab" data-ptab="ratio">Ratio Table</button>
            <button class="projector-tool-tab" type="button" data-act="proj-tool-tab" data-ptab="coord">Coordinate Plane</button>
          </div>
          <button class="btn btn-sm" type="button" data-act="toggle-proj-tools">Close Tools</button>
        </div>
        <div class="projector-tool-panel active" id="projPanelFraction">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap">
            <label style="font-size:12px;font-weight:700">Denominator: <input type="number" id="projDenomInput" min="1" max="16" value="4" style="width:55px;padding:3px 6px"></label>
            <label style="font-size:12px;font-weight:700">Numerator: <input type="number" id="projNumInput" min="0" max="16" value="3" style="width:55px;padding:3px 6px"></label>
            <span style="font-size:12px;color:var(--ink-2)">Click any cell to toggle shading</span>
          </div>
          <div id="projFractionStripContainer" class="fraction-strip-display"></div>
        </div>
        <div class="projector-tool-panel" id="projPanelRatio">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap">
            <label style="font-size:12px;font-weight:700">Base Ratio: <input type="number" id="projRatioA" value="2" style="width:55px;padding:3px 6px"> : <input type="number" id="projRatioB" value="5" style="width:55px;padding:3px 6px"></label>
            <button class="btn btn-sm" type="button" id="projGenRatioBtn">Update Table</button>
          </div>
          <div id="projRatioContainer"></div>
        </div>
        <div class="projector-tool-panel" id="projPanelCoord">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap">
            <label style="font-size:12px;font-weight:700">Plot (x, y): <input type="number" id="projCoordX" value="3" min="-8" max="8" style="width:55px;padding:3px 6px"> , <input type="number" id="projCoordY" value="-4" min="-8" max="8" style="width:55px;padding:3px 6px"></label>
            <button class="btn btn-sm" type="button" id="projPlotBtn">Plot Point</button>
          </div>
          <div id="projCoordContainer" style="display:flex;justify-content:center"></div>
        </div>
      </div>

      <div class="modal-answer" id="modalAnswer"><div id="modalAnswerBody"></div></div>
    </div>
  </div>
</div>

<!-- Virtual Math Tools Modal -->
<div class="backdrop" id="toolsBackdrop">
  <div class="modal modal-math-tools" id="toolsModal" role="dialog" aria-modal="true" aria-labelledby="toolsTitle" tabindex="-1">
    <div class="modal-head">
      <div class="modal-title-row">
        <div>
          <span class="modal-badge">Interactive Math Manipulatives</span>
          <h2 id="toolsTitle">Virtual Math Workbench</h2>
        </div>
        <button class="icon-btn" type="button" data-act="close-tools" aria-label="Close tools">&times;</button>
      </div>
      <div class="tools-tablist" role="tablist" aria-label="Math tools">
        <button class="tools-tab-btn active" type="button" role="tab" id="tool-tab-ratio" aria-controls="tool-ratio" tabindex="0" data-act="tool-tab" data-tab="ratio" aria-selected="true">Ratio Table &amp; Number Line</button>
        <button class="tools-tab-btn" type="button" role="tab" id="tool-tab-coord" aria-controls="tool-coord" tabindex="-1" data-act="tool-tab" data-tab="coord" aria-selected="false">Coordinate Plane (4-Quadrant)</button>
        <button class="tools-tab-btn" type="button" role="tab" id="tool-tab-fraction" aria-controls="tool-fraction" tabindex="-1" data-act="tool-tab" data-tab="fraction" aria-selected="false">Fraction &amp; Percent Strips</button>
        <button class="tools-tab-btn" type="button" role="tab" id="tool-tab-keypad" aria-controls="tool-keypad" tabindex="-1" data-act="tool-tab" data-tab="keypad" aria-selected="false">Math Keypad</button>
      </div>
    </div>
    <div class="modal-body" id="toolsBody">
      <!-- Tool 1: Ratio Table -->
      <div class="tool-panel" role="tabpanel" aria-labelledby="tool-tab-ratio" id="tool-ratio">
        <h3>Interactive Ratio Table &amp; Double Number Line</h3>
        <p class="tool-sub">Enter two nonnegative quantities, with a positive second quantity. Compare equivalent pairs, identify the unit rate, and explain why both rows scale together.</p>
        <div class="ratio-builder">
          <div class="ratio-inputs">
            <label>Quantity 1 Label: <input type="text" id="ratioLabel1" value="Miles" maxlength="32"></label>
            <label>Value 1: <input type="number" id="ratioVal1" value="120" step="any"></label>
            <label>Quantity 2 Label: <input type="text" id="ratioLabel2" value="Hours" maxlength="32"></label>
            <label>Value 2: <input type="number" id="ratioVal2" value="2" step="any"></label>
            <button class="btn btn-primary btn-sm" type="button" data-act="calc-ratio">Generate Table</button>
          </div>
          <div id="ratioTableOutput"></div>
          <div id="doubleNumberLineOutput"></div>
        </div>
      </div>

      <!-- Tool 2: Coordinate Plane -->
      <div class="tool-panel" role="tabpanel" aria-labelledby="tool-tab-coord" id="tool-coord" hidden>
        <h3>4-Quadrant Coordinate Grid Explorer</h3>
        <p class="tool-sub">Enter x and y from −10 to 10, including decimals, or click a grid intersection. Coordinates tell horizontal movement first, then vertical movement. Explore reflections across either axis.</p>
        <div class="coord-builder">
          <div class="coord-controls">
            <label>X: <input type="number" id="coordX" value="3" min="-10" max="10" step="any"></label>
            <label>Y: <input type="number" id="coordY" value="-4" min="-10" max="10" step="any"></label>
            <button class="btn btn-primary btn-sm" type="button" data-act="plot-point">Plot Point</button>
            <button class="btn btn-sm" type="button" data-act="reflect-x">Reflect over X-Axis</button>
            <button class="btn btn-sm" type="button" data-act="reflect-y">Reflect over Y-Axis</button>
            <button class="btn btn-sm" type="button" data-act="clear-points">Clear Points</button>
            <span id="coordReadout" class="coord-readout" role="status" aria-live="polite">Point: (3, -4)</span>
          </div>
          <div class="coord-plane-wrapper">
            <svg id="coordSvg" viewBox="-240 -240 480 480" width="460" height="460" aria-label="Interactive 4-Quadrant Coordinate Plane"></svg>
          </div>
        </div>
      </div>

      <!-- Tool 3: Fraction & Percent Strips -->
      <div class="tool-panel" role="tabpanel" aria-labelledby="tool-tab-fraction" id="tool-fraction" hidden>
        <h3>Fraction &amp; Percent Bar Models</h3>
        <p class="tool-sub">Partition every whole into the same number of equal parts. Use a whole-number denominator from 1 to 24 and a nonnegative whole-number numerator representing up to 5 wholes. Approximate decimals are marked with ≈.</p>
        <div class="fraction-builder">
          <div class="fraction-inputs">
            <label>Numerator: <input type="number" id="fracNum" value="3" min="0" max="120" step="1"></label>
            <label>Denominator: <input type="number" id="fracDen" value="4" min="1" max="24" step="1"></label>
            <button class="btn btn-primary btn-sm" type="button" data-act="render-strip">Render Strip</button>
          </div>
          <div id="fractionStripOutput"></div>
        </div>
      </div>

      <!-- Tool 4: Math Keypad -->
      <div class="tool-panel" role="tabpanel" aria-labelledby="tool-tab-keypad" id="tool-keypad" hidden>
        <h3>On-Screen Math Keypad</h3>
        <p class="tool-sub">Use on touchscreens, Chromebooks, or iPads to insert mathematical symbols into any active response box.</p>
        <div class="onscreen-keypad">
          <button type="button" class="key-btn" data-key="7">7</button>
          <button type="button" class="key-btn" data-key="8">8</button>
          <button type="button" class="key-btn" data-key="9">9</button>
          <button type="button" class="key-btn key-op" data-key="/">÷ (a/b)</button>
          <button type="button" class="key-btn key-op" data-key="^2">x²</button>

          <button type="button" class="key-btn" data-key="4">4</button>
          <button type="button" class="key-btn" data-key="5">5</button>
          <button type="button" class="key-btn" data-key="6">6</button>
          <button type="button" class="key-btn key-op" data-key="*">×</button>
          <button type="button" class="key-btn key-op" data-key="%">%</button>

          <button type="button" class="key-btn" data-key="1">1</button>
          <button type="button" class="key-btn" data-key="2">2</button>
          <button type="button" class="key-btn" data-key="3">3</button>
          <button type="button" class="key-btn key-op" data-key="-">−</button>
          <button type="button" class="key-btn key-op" data-key="$">$</button>

          <button type="button" class="key-btn" data-key="0">0</button>
          <button type="button" class="key-btn" data-key=".">.</button>
          <button type="button" class="key-btn key-op" data-key="pm">±</button>
          <button type="button" class="key-btn key-op" data-key="+">+</button>
          <button type="button" class="key-btn key-del" data-key="del">⌫ Del</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Classroom Diagnostics & Insights Modal -->
