        </div>
      </div>
    </div>
    <div class="modal-body">
      <!-- Annotation Toolbar (when active) -->
      <div class="annotation-bar" id="annotationBar" hidden>
        <span>Annotation Tools:</span>
        <button type="button" class="btn btn-sm active" data-act="pen-mode" data-mode="highlighter">🟡 Highlighter</button>
        <button type="button" class="btn btn-sm" data-act="pen-mode" data-mode="pen">🖊️ Pen</button>
        <button type="button" class="btn btn-sm" data-act="pen-mode" data-mode="eraser">🧹 Eraser</button>
        <button type="button" class="btn btn-sm" data-act="clear-annotation">Clear All</button>
      </div>

      <div class="projector-container">
        <div class="projector" id="projectorBox">
