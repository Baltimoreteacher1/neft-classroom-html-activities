<!-- Print & Export Center Modal -->
<div class="backdrop" id="printBackdrop">
  <div class="modal modal-print-center" id="printModal" role="dialog" aria-modal="true" aria-labelledby="printModalTitle" tabindex="-1">
    <div class="modal-head">
      <div>
        <span class="modal-badge">Publishing &amp; Distribution</span>
        <h2 id="printModalTitle">Print &amp; Export Center</h2>
      </div>
      <button class="icon-btn" type="button" data-act="close-print" aria-label="Close Print Center">&times;</button>
    </div>
    <div class="modal-body">
      <p class="print-center-sub">Generate publication-quality student worksheets, worked teacher keys, multi-lesson unit workbooks, fluency drills, or export a standalone student edition file. Print directly to your browser's PDF engine.</p>

      <div class="print-cards-grid">
        <div class="print-card">
          <div class="print-card-icon">📄</div>
          <div class="print-card-content">
            <h3>Current Lesson Worksheet</h3>
            <p>Print the selected lesson's practice tasks. Choose Foundation (4 tasks), Connect &amp; Apply (8 tasks), or Extend &amp; Explain (4 tasks).</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px">
              <div>
                <label for="printLessonSelect" style="font-size:11px;font-weight:700;display:block;margin-bottom:2px">Lesson:</label>
                <select class="select select-sm" id="printLessonSelect" style="width:100%"></select>
              </div>
              <div>
                <label for="printTierSelect" style="font-size:11px;font-weight:700;display:block;margin-bottom:2px">Differentiation Tier:</label>
                <select class="select select-sm" id="printTierSelect" style="width:100%">
                  <option value="core">Connect &amp; Apply (8 tasks)</option>
                  <option value="foundation">Build Foundations (4 tasks)</option>
                  <option value="stretch">Extend &amp; Explain (4 tasks)</option>
                </select>
              </div>
            </div>
            <div class="print-card-actions">
              <button class="btn btn-primary btn-sm" type="button" data-act="print-lesson-student">Print Student Worksheet</button>
              <button class="btn btn-sm" type="button" data-act="print-lesson-key">Print Teacher Key</button>
            </div>
          </div>
        </div>

        <div class="print-card">
          <div class="print-card-icon">📦</div>
          <div class="print-card-content">
            <h3>Full Unit Multi-Lesson Workbook</h3>
            <p>Print all lessons in a unit as a ready-to-distribute student workbook or comprehensive teacher key packet.</p>
            <div class="print-card-actions">
              <label class="sr-only" for="printUnitSelect">Select unit to print</label>
              <select class="select select-sm" id="printUnitSelect">
                {{PRINT_UNIT_OPTIONS}}
              </select>
              <button class="btn btn-primary btn-sm" type="button" data-act="print-unit-pack">Print Unit Student Pack</button>
              <button class="btn btn-sm" type="button" data-act="print-unit-keys">Print Unit Key Pack</button>
            </div>
          </div>
        </div>

        <div class="print-card">
          <div class="print-card-icon">⚡</div>
          <div class="print-card-content">
            <h3>Fluency Spine Core Drills</h3>
            <p>Print 6-item warm-up drills for the 12 core mathematical spine skills that support Grade 6 success.</p>
            <div style="margin-bottom:8px">
              <label for="printDrillSelect" style="font-size:11px;font-weight:700;display:block;margin-bottom:2px">Select Spine Drill:</label>
              <select class="select select-sm" id="printDrillSelect" style="width:100%"></select>
            </div>
            <div class="print-card-actions">
              <button class="btn btn-primary btn-sm" type="button" data-act="print-current-drill">Print Selected Drill</button>
              <button class="btn btn-sm" type="button" data-act="print-drill-key">Print Drill Key</button>
              <button class="btn btn-sm" type="button" data-act="print-all-drills">Print All 12 Drills</button>
              <button class="btn btn-sm" type="button" data-act="print-all-drill-keys">Print All 12 Keys</button>
            </div>
          </div>
        </div>

        <div class="print-card">
          <div class="print-card-icon">👥</div>
          <div class="print-card-content">
            <h3>Partner Activity Lab Sheet</h3>
            <p>Print the 12–15 min partner investigation sheet with Solve, Investigate, Repair, and Transfer prompts.</p>
            <div style="margin-bottom:8px">
              <label for="printPartnerLessonSelect" style="font-size:11px;font-weight:700;display:block;margin-bottom:2px">Select Lesson for Lab:</label>
              <select class="select select-sm" id="printPartnerLessonSelect" style="width:100%"></select>
            </div>
            <div class="print-card-actions">
              <button class="btn btn-primary btn-sm" type="button" data-act="print-partner-student">Print Partner Sheet</button>
              <button class="btn btn-sm" type="button" data-act="print-partner-key">Print Teacher Facilitation</button>
            </div>
          </div>
        </div>

        <div class="print-card">
          <div class="print-card-icon">📅</div>
          <div class="print-card-content">
            <h3>5-Day Weekly Bellringer Sheet</h3>
            <p>Generate a 5-day Monday through Friday student bellringer page with student workboxes or teacher keys.</p>
            <div class="print-card-actions">
              <button class="btn btn-primary btn-sm" type="button" data-act="print-week-student">Print Student 5-Day Sheet</button>
              <button class="btn btn-sm" type="button" data-act="print-week-key">Print Teacher Weekly Key</button>
            </div>
          </div>
        </div>

        <div class="print-card">
          <div class="print-card-icon">💾</div>
          <div class="print-card-content">
            <h3>Export Standalone Student Edition (HTML)</h3>
