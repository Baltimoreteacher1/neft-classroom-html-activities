          <button class="icon-btn" type="button" id="fullscreenBtn" data-act="toggle-fullscreen" aria-label="Toggle fullscreen (F)" title="Fullscreen (F)">⛶</button>
        </div>
        <div class="modal-control-group" role="group" aria-label="Interactive tools">
          <button class="icon-btn" type="button" id="readPromptBtn" data-act="speak-prompt" title="Listen to prompt (Text-to-Speech)" aria-label="Read prompt aloud">🔊</button>
