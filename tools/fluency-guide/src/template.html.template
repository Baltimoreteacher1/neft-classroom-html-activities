          <button class="icon-btn" type="button" id="coldCallBtn" data-act="open-coldcall" title="Random Student / Table Selector" aria-label="Random student selector">🎲</button>
          <button class="icon-btn" type="button" id="projMathToolsBtn" data-act="toggle-proj-tools" aria-pressed="false" title="In-projector math manipulatives drawer" aria-label="Toggle projector math manipulatives">🧮</button>
