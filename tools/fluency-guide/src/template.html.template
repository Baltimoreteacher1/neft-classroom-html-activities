<!-- Projector modal -->
<div class="backdrop" id="backdrop">
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" tabindex="-1">
    <div class="modal-head">
      <div>
        <span class="modal-badge" id="modalBadge">Lesson</span>
        <h2 id="modalTitle"></h2>
      </div>
      <div class="modal-nav">
        <div class="form-switch" id="modalForms" role="group" aria-label="Quick check version"></div>
        <button class="icon-btn" type="button" data-act="modal-prev" aria-label="Previous lesson" title="Previous lesson (←)">‹</button>
        <button class="icon-btn" type="button" data-act="modal-next" aria-label="Next lesson" title="Next lesson (→)">›</button>
        <button class="icon-btn" type="button" data-act="close-modal" aria-label="Close" title="Close (Esc)">&times;</button>
      </div>
    </div>
    <div class="modal-body">
      <div class="projector">
        <div class="label">Quick check — answer on your whiteboard</div>
        <div class="prompt" id="modalPrompt"></div>
      </div>

      <div class="timer-box">
        <div style="display:flex;align-items:center;gap:14px">
          <span class="timer-digits" id="timerDigits">02:00</span>
          <span class="timer-meta"><b>Timer</b>Space = start/pause · R = reset · S = show answer</span>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-left:auto">
          <button class="btn btn-sm" type="button" data-act="preset" data-seconds="30" aria-pressed="false">30s</button>
          <button class="btn btn-sm" type="button" data-act="preset" data-seconds="60" aria-pressed="false">1m</button>
          <button class="btn btn-sm" type="button" data-act="preset" data-seconds="120" aria-pressed="true">2m</button>
          <button class="btn btn-sm" type="button" data-act="preset" data-seconds="180" aria-pressed="false">3m</button>
          <button class="btn btn-primary" type="button" id="timerBtn" data-act="timer">Start</button>
          <button class="btn" type="button" data-act="timer-reset">Reset</button>
          <button class="btn btn-ok" type="button" id="revealBtn" data-act="reveal" aria-expanded="false" aria-controls="modalAnswer">Reveal answer</button>
        </div>
        <div class="timer-track"><div class="timer-fill" id="timerFill"></div></div>
      </div>

      <div class="modal-answer" id="modalAnswer"><div id="modalAnswerBody"></div></div>
    </div>
  </div>
</div>

