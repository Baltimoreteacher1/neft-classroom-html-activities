<noscript><p style="padding:20px;background:#fff3cd;color:#856404">Enable JavaScript to open interactive practice. Your teacher can also provide a printed worksheet.</p></noscript>

<header class="site-header" role="banner">
  <div class="wrap header-inner">
    <div class="brand">
      <span class="brand-badge" aria-hidden="true">R6</span>
      <span>
        <span class="brand-series">EduWonderLab · Grade 6</span>
        <span class="brand-title">Reveal Math Fluency &amp; Readiness</span>
      </span>
    </div>
    <div class="header-actions">
      <a class="btn btn-sm" href="/curriculum/">Curriculum Overview</a>
      <a class="btn btn-sm" href="/curriculum/units/">All Units</a>
      <a class="btn btn-sm" href="/curriculum/extra-help/">Extra Help</a>
      <button class="btn btn-sm" type="button" id="themeBtn" aria-pressed="false" aria-label="Toggle dark mode">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <span class="label">Dark</span>
      </button>
    </div>
  </div>
</header>

<nav class="viewbar" aria-label="Guide sections" role="navigation">
  <div class="wrap viewbar-inner" role="tablist" aria-orientation="horizontal" id="viewTablist">
    <button class="viewtab active" role="tab" type="button" id="tab-lessons" aria-controls="view-lessons" data-act="view" data-view="lessons" aria-selected="true" tabindex="0">Lessons Index <span class="count">{{LESSONS}}</span></button>
    <button class="viewtab" role="tab" type="button" id="tab-studio" aria-controls="view-studio" data-act="view" data-view="studio" aria-selected="false" tabindex="-1">Practice Studio <span class="count count-featured">PRACTICE</span></button>
  </div>
</nav>

<main id="main" tabindex="-1">
  <div class="wrap section">
    <div data-panel="lessons" id="view-lessons" role="tabpanel" aria-labelledby="tab-lessons" tabindex="0">
      <section class="fluency-hero" aria-labelledby="fluencyHeroHeading">
        <div class="fluency-hero-badge">Reveal Math · McGraw Hill Alignment · Grade 6</div>
        <h1 id="fluencyHeroHeading">Fluency &amp; Readiness Index</h1>
        <p class="lead">
          Master foundational fluency for Grade 6 mathematics. Explore {{LESSONS}} lessons across Units {{UNIT_RANGE}} with prerequisite skill progressions, 2-minute diagnostic quick checks, and interactive practice studios.
        </p>
        <div class="fluency-hero-stats">
          <span class="fluency-stat-pill"><strong>{{LESSONS}}</strong> Lessons</span>
          <span class="fluency-stat-pill"><strong>{{PREREQS}}</strong> Prerequisite Skills</span>
          <span class="fluency-stat-pill"><strong>{{UNITS}}</strong> Units (Units {{UNIT_RANGE}})</span>
          <span class="fluency-stat-pill"><strong>{{TASKS}}</strong> Interactive Tasks</span>
        </div>
      </section>

      <div class="fluency-toolbar" role="search" aria-label="Lesson filters">
        <div class="fluency-toolbar-row">
          <div class="fluency-search-box">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" id="fluencySearchInput" placeholder="Search lesson (e.g. 2-6), skill (e.g. divide), or standard (e.g. 6.NS)…" autocomplete="off" aria-label="Search lessons by title, id, skill, or standard">
            <button type="button" class="clear-btn" id="fluencySearchClear" aria-label="Clear search query" style="display:none">&times;</button>
          </div>

          <div class="fluency-filters-group">
            <label class="sr-only" for="fluencyUnitSelect">Filter by unit</label>
            <select id="fluencyUnitSelect" class="fluency-select">
              <option value="all">All Units (Units {{UNIT_RANGE}})</option>
{{STUDENT_UNIT_OPTIONS}}
            </select>

            <label class="sr-only" for="fluencyOriginSelect">Filter by prerequisite origin</label>
            <select id="fluencyOriginSelect" class="fluency-select">
              <option value="all">All Prerequisite Origins</option>
              <option value="elementary">Elementary Origins (Gr 2–5)</option>
              <option value="spiral">In-Year Spiral (Grade 6)</option>
            </select>
          </div>

          <div class="fluency-results-count" id="fluencyResults" role="status" aria-live="polite">
            Showing {{LESSONS}} of {{LESSONS}} lessons
          </div>
        </div>

        <div class="fluency-domain-pills" role="group" aria-label="Filter by CCSS Domain">
          <button type="button" class="domain-pill active" data-domain="all" aria-pressed="true">All Domains</button>
          <button type="button" class="domain-pill" data-domain="6.RP" aria-pressed="false">6.RP (Ratios &amp; Rates)</button>
          <button type="button" class="domain-pill" data-domain="6.NS" aria-pressed="false">6.NS (Number System)</button>
          <button type="button" class="domain-pill" data-domain="6.EE" aria-pressed="false">6.EE (Expressions &amp; Equations)</button>
          <button type="button" class="domain-pill" data-domain="6.G" aria-pressed="false">6.G (Geometry)</button>
          <button type="button" class="domain-pill" data-domain="6.SP" aria-pressed="false">6.SP (Statistics)</button>
        </div>
      </div>

      <div id="fluencyLessonsContainer">
        <!--__LESSONS_INDEX__-->
      </div>
    </div>

    <div data-panel="studio" id="view-studio" role="tabpanel" aria-labelledby="tab-studio" tabindex="0" hidden></div>
  </div>
</main>
<div id="studio-print"></div>

<footer class="site-footer" role="contentinfo">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <p><strong>EduWonderLab · Grade 6 · Reveal Math Fluency Edition.</strong> Diagnostic checks, prerequisite foundations, worked practice, and interactive workshops for Units {{UNIT_RANGE}} ({{LESSONS}} lessons).</p>
      </div>
      <div class="footer-meta">
        <span>Reveal Math aligned supplemental fluency</span>
      </div>
    </div>
  </div>
</footer>

<script>window.FluencyData = /*__DATA__*/;</script>
<script id="fluency-models">/*__MODELS__*/</script>
<script id="fluency-studio">/*__STUDIO__*/</script>
<script src="/assets/curriculum-fluency-index.js"></script>
<script>
  // Theme management for student edition
  const themeBtn = document.getElementById('themeBtn');
  function setTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    if (themeBtn) {
      themeBtn.querySelector('.label').textContent = t === 'dark' ? 'Light' : 'Dark';
      themeBtn.setAttribute('aria-pressed', String(t === 'dark'));
    }
    try { localStorage.setItem('rmg6.theme.v3', JSON.stringify(t)); } catch(_) {}
  }
  let savedTheme = 'light';
  try { savedTheme = JSON.parse(localStorage.getItem('rmg6.theme.v3')) || 'light'; } catch(_) {}
  setTheme(savedTheme);
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-theme') || 'light';
      setTheme(cur === 'dark' ? 'light' : 'dark');
    });
  }

  // Self-contained View Router and Studio Initializer (offline & standalone compatible)
  (function () {
    const tabLessons = document.getElementById('tab-lessons');
    const tabStudio = document.getElementById('tab-studio');
    const viewLessons = document.getElementById('view-lessons');
    const viewStudio = document.getElementById('view-studio');

    function routeView() {
      const hash = window.location.hash || '';
      const params = new URLSearchParams(hash.replace(/^#/, ''));
      const isStudio =
        params.get('view') === 'studio' ||
        params.has('lesson') ||
        params.has('level') ||
        params.has('mode');

      if (isStudio) {
        if (viewLessons) viewLessons.hidden = true;
        if (viewStudio) {
          viewStudio.hidden = false;
          if (!document.getElementById('studioBackNav')) {
            const backNav = document.createElement('div');
            backNav.id = 'studioBackNav';
            backNav.className = 'studio-nav-bar';
            backNav.innerHTML = `
              <a href="#view=lessons" class="btn btn-sm btn-back" id="btnBackToLessons">
                ← Back to Lessons Index ({{LESSONS}} Lessons)
              </a>
              <span style="font-size:12.5px;color:var(--ink-3);font-weight:600">
                Interactive Practice Studio · Reveal Math Grade 6
              </span>
            `;
            viewStudio.prepend(backNav);
          }
        }
        if (tabLessons) {
          tabLessons.setAttribute('aria-selected', 'false');
          tabLessons.classList.remove('active');
        }
        if (tabStudio) {
          tabStudio.setAttribute('aria-selected', 'true');
          tabStudio.classList.add('active');
        }
        if (window.FluencyStudio && typeof window.FluencyStudio.render === 'function') {
          window.FluencyStudio.render();
        }
      } else {
        if (viewLessons) viewLessons.hidden = false;
        if (viewStudio) viewStudio.hidden = true;
        if (tabLessons) {
          tabLessons.setAttribute('aria-selected', 'true');
          tabLessons.classList.add('active');
        }
        if (tabStudio) {
          tabStudio.setAttribute('aria-selected', 'false');
          tabStudio.classList.remove('active');
        }
        if (hash && hash !== '#view=lessons') {
          const target = document.querySelector(hash);
          if (target) {
            setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 50);
          }
        }
      }
    }

    window.addEventListener('hashchange', routeView);
    routeView();
  })();
</script>
</body>
</html>
