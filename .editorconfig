# EditorConfig — baseline for editors without the Biome extension.
# Values match biome.json (the repo formatter): 2-space indent, LF, width 100.
# biome.json's explicit settings take precedence for Biome itself; this file
# mainly helps other editors (vim, Sublime, etc.) stay consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown: trailing spaces are meaningful (hard line breaks).
[*.md]
trim_trailing_whitespace = false
