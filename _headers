# Cloudflare Pages custom headers for Neft Teacher static activity hub
# Keep this file in the repository root because the build output directory is the repository root.

# Default for everything: security headers + ALWAYS-REVALIDATE caching.
# max-age=0, must-revalidate means the browser checks with the server (ETag) on
# every load and gets a cheap 304 when unchanged — so updated pages, tool scripts
# (app.js/css), data files, games, and WIDA studios appear immediately, with no
# hard refresh needed.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Framing policy: allow this site to be embedded by itself, by Canvas LMS
  # (all *.instructure.com subdomains, incl. bcps.instructure.com), and by SCORM
  # players — SCORM Cloud (*.scorm.com) and Rustici-engine content hosts
  # (*.scormcontent.com), which is how SCORM packages iframe the live lesson and
  # report grades. CSP frame-ancestors replaces the old X-Frame-Options:
  # SAMEORIGIN (which blocked all cross-origin framing). Everyone else is blocked.
  Content-Security-Policy: frame-ancestors 'self' https://*.instructure.com https://*.scorm.com https://*.scormcontent.com
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cache-Control: public, max-age=0, must-revalidate

# Lesson pages only: allow embedding by ANY frame ancestor. BCPS Canvas's SCORM
# player (an LTI tool, not SCORM Cloud) iframes the live lesson from a domain
# that isn't a *.scorm.com/*.scormcontent.com host, so the strict /* policy
# above blocked it (console: "Framing 'https://eduwonderlab.com/' violates
# frame-ancestors"). Lessons carry no auth or sensitive actions, so permitting
# framing here is low-risk; the rest of the site keeps the strict policy. This
# is what lets a SCORM-embedded lesson render and report its grade.
/lessons/*
  Content-Security-Policy: frame-ancestors *

# Vite build output is content-hashed (filename changes whenever content changes),
# so these are safe to cache for a long time / immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ACCESS Practice Lab HTML shell: NEVER cache the entry pages, so a deploy is
# seen immediately (the versioned ?v= app.js/data underneath still cache fine).
# This is the SPA hub + the clean activity/test URLs served by the Pages Function.
/access-practice-lab/
  Cache-Control: no-store
/access-teacher/
  Cache-Control: no-store

# Command Center PWA: service worker and manifest must always revalidate.
/teacher-tools/neftos-command-center/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /teacher-tools/neftos-command-center/

/teacher-tools/neftos-command-center/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
