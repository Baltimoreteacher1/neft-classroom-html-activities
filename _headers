# Cloudflare Pages custom headers for Neft Teacher static activity hub
# Keep this file in the repository root because the build output directory is the repository root.

# Default for everything: security headers ONLY. Deliberately NO Cache-Control here.
#
# Cloudflare Pages COMBINES every matching rule rather than letting the most
# specific one win: "An incoming request which matches multiple rules' URL
# patterns will inherit all rules' headers", and "if a header is applied twice
# in the _headers file, the values are joined with a comma separator."
# Because `/*` matches every request, any Cache-Control set here is concatenated
# onto every per-path Cache-Control below. That is exactly what production was
# serving on 2026-07-31:
#
#   cache-control: public, max-age=0, must-revalidate, no-store, no-cache,
#                  must-revalidate, max-age=0, no-store, no-cache,
#                  must-revalidate, max-age=0
#   expires: 0, 0     pragma: no-cache, no-cache
#
# (three overlapping /curriculum rules + this one). A malformed multi-valued
# Cache-Control is parsed by the strictest directive present, so `no-store` won
# and the 72 KB brotli hub re-downloaded on EVERY visit with the ETag unusable.
#
# Removing Cache-Control here changes nothing about the effective policy for
# unmatched paths: Pages' own default for cacheable assets is already
# `public, max-age=0, must-revalidate`, and Pages always sends ETags, so the
# browser still revalidates on every load and still gets a cheap 304.
# RULE FOR EDITORS: never set the same header on two rules that can match the
# same URL. Cache-Control belongs on exactly one matching rule per path.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Framing policy: allow this site to be embedded by itself, by Canvas LMS, and
  # by ANY https LMS/SCORM player. BCPS Canvas's SCORM tool iframes the live
  # lesson from its own (non-SCORM-Cloud) https domain, and Cloudflare APPENDS
  # per-path CSP headers rather than overriding them — two CSP headers are
  # enforced as their intersection (most restrictive) — so a /lessons/* override
  # can't loosen a strict global. The global itself must permit https framers.
  # `'self' https:` allows any https ancestor (every LMS/SCORM host) while still
  # blocking non-https (data:/blob: opaque) framing. Lesson pages carry no auth
  # or sensitive one-click actions, so this is low clickjacking risk. This is
  # what lets a SCORM-embedded lesson render inside Canvas and report its grade.
  Content-Security-Policy: frame-ancestors 'self' https:
  # microphone=(self): the Speech-Language Screening tool records speech samples
  # via getUserMedia. A per-path override can't loosen this — browsers enforce
  # the INTERSECTION of all matching Permissions-Policy headers (like the CSP
  # note above), so microphone=() globally would still block it. (self) permits
  # ONLY same-origin pages to REQUEST the mic; the browser still prompts the user
  # for permission. camera/geolocation/payment/usb stay fully blocked.
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()

# /assets/ holds BOTH Vite content-hashed bundles (e.g. lesson-renderer-<hash>.js,
# safe to cache forever) AND stable-named shared scripts that are hand-edited and
# injected site-wide (math-workbench-launcher.js, futures-tutor.js/.css,
# nt-page-enhance.js, edupulse-*.js, lesson-shell-guard.js, game-fx.*, etc.).
# `immutable` was WRONG for the stable-named ones: their filename never changes,
# so browsers/edge pinned the OLD copy for up to a year and deploys never reached
# students (the 2026-07-05 compact-launcher fix was stuck behind exactly this).
# Use the same always-revalidate policy as the site default: the browser keeps the
# file cached and sends a conditional request, getting a cheap 304 when unchanged
# (no re-download of the big hashed bundles) but the CURRENT file the moment it
# changes. Hashed bundles also get a fresh URL on change, so they never re-fetch
# needlessly.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# Curriculum Hub HTML: must never be USED without checking with the server, so
# newly organized lessons appear on every visit (the hub's lesson menus are
# assembled from inline page data, so the HTML itself is the cache-bust
# boundary).
#
# `no-cache` — NOT `no-store` — is what expresses that. Both force a check
# before the document is used; the difference is that `no-store` forbids
# keeping a copy at all, so the browser cannot send If-None-Match and Pages
# can never answer 304. That cost a full 72 KB (brotli) re-download of a
# 580 KB document on every single page view, for zero freshness benefit.
# With `no-cache, must-revalidate` the browser still revalidates every time
# and still shows new lesson ordering immediately — it just gets a ~200-byte
# 304 when nothing changed. `must-revalidate` additionally forbids serving the
# stored copy when the revalidation request fails.
#
# These three are EXACT paths and cannot match each other; the old
# `/curriculum*` prefix rule matched all three (and every asset beneath
# /curriculum/) and was the source of the tripled header value. Assets under
# /curriculum/ now fall through to the Pages default
# (public, max-age=0, must-revalidate) — still revalidated on every load,
# but 304-able.
/curriculum
  Cache-Control: public, no-cache, must-revalidate
/curriculum/
  Cache-Control: public, no-cache, must-revalidate
/curriculum/index.html
  Cache-Control: public, no-cache, must-revalidate

# ACCESS Practice Lab HTML shell: the entry pages must be re-checked on every
# load so a deploy is seen immediately (the versioned ?v= app.js/data underneath
# still cache fine). This is the SPA hub + the clean activity/test URLs served
# by the Pages Function. Same reasoning as the curriculum hub above: `no-cache`
# revalidates just as strictly as `no-store` but permits a 304 instead of
# re-sending the whole shell.
#
# NOTE: these are exact paths, so /access-practice-lab/config.json — the public
# build stamp that ship.sh and smoke:live poll — is NOT matched here and keeps
# the Pages default. Those pollers append their own cache-buster anyway.
/access-practice-lab/
  Cache-Control: public, no-cache, must-revalidate
/access-teacher/
  Cache-Control: public, no-cache, must-revalidate

# Command Center PWA: service worker and manifest must always revalidate.
/teacher-tools/neftos-command-center/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /teacher-tools/neftos-command-center/

/teacher-tools/neftos-command-center/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# Offline service workers (lesson launchers + practice arcade): must always
# revalidate so a deploy replaces the worker immediately.
/lessons/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /lessons/

/math/games/practice-arcade/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /math/games/practice-arcade/
