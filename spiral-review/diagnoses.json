  "tags": {
    "compare-negative-magnitude": {
      "label": "Compared negatives by their distance from zero",
      "student": "On a number line, numbers get greater to the right and less to the left. Where does each of these sit? A negative that is farther from zero is actually less, not greater."
    },
    "decimal-place-value": {
      "label": "Right digits, wrong magnitude",
      "student": "Your digits are right — the decimal point landed in the wrong spot. Round to the nearest whole number first and see roughly where the answer should sit."
    },
    "exponent-as-multiplication": {
      "label": "Multiplied the base by the exponent",
      "student": "It looks like you multiplied the base by the exponent. 2³ means 2 × 2 × 2 — write out every factor before you evaluate."
    },
    "fraction-no-reciprocal": {
      "label": "Divided fractions without inverting",
      "student": "You multiplied the fractions just as they were written. When you divide by a fraction, the second one flips first."
    },
    "geom-triangle-area-no-half": {
      "label": "Found base × height but forgot the half",
      "student": "You multiplied base × height, but that gives the whole rectangle. A triangle is half of that rectangle — take half of your answer."
    },
    "op-added-instead-of-multiplied": {
      "label": "Added when the problem multiplies",
      "student": "It looks like you added those two numbers. This one is asking for groups of something, which means multiplying. How many groups are there, and how big is each one?"
    },
    "op-multiplied-instead-of-added": {
      "label": "Multiplied when the problem adds",
      "student": "It looks like you multiplied. This problem puts two amounts together, so it adds. Try telling it back as a story first, then pick the operation."
    },
    "op-multiplied-instead-of-divided": {
      "label": "Multiplied when the problem divides",
      "student": "It looks like you multiplied. Estimate before you compute: should this answer end up bigger or smaller than what you started with?"
    },
    "op-reversed-division": {
      "label": "Divided in the wrong order",
      "student": "The two numbers got swapped in the division. Ask yourself: what is being split up? That number goes first."
    },
    "op-reversed-subtraction": {
      "label": "Subtracted in the wrong order",
      "student": "You subtracted in the other order. Check which amount you started with — that one goes first."
    },
    "percent-scale-off-by-100": {
      "label": "Percent answer off by a factor of 100",
      "student": "Your answer is off by a factor of 100. Check it against something you already know: 50% is half, and 10% is one tenth."
    },
    "percent-used-as-whole-number": {
      "label": "Used the percent as a plain number",
      "student": "The percent got used as a plain number. Say it out loud as “per hundred” — 15% means 15 out of every 100, not 15."
    },
    "sign-dropped": {
      "label": "Right magnitude, lost the negative sign",
      "student": "The size of your answer is right, but the negative sign went missing. Put it on a number line — which side of zero does it belong on?"
    },
    "stat-summed-instead-of-averaged": {
      "label": "Added the data set instead of averaging it",
      "student": "That is the total of the data, not its average. Could your answer be one realistic value from that list? An average has to land inside the data."
    }
  },
