{
  "$schema": "docs/style-guide.md",
  "version": 1,
  "palette": {
    "navy": "#17324D",
    "teal": "#1FA6A2",
    "amber": "#F2C15B",
    "canvas": "#F7F4EC",
    "text": "#24323F",
    "white": "#FFFFFF",
    "success": "#0F7C4A",
    "error": "#B3402A"
  },
  "derive": {
    "tealInk": {
      "from": "teal",
      "minContrast": 4.5,
      "onBackgrounds": [
        "canvas",
        "white"
      ]
    },
    "amberInk": {
      "from": "amber",
      "minContrast": 4.5,
      "onBackgrounds": [
        "canvas",
        "white"
      ]
    },
    "muted": {
      "from": "text",
      "toward": "canvas",
      "amount": 0.18,
      "minContrast": 4.5,
      "onBackgrounds": [
        "canvas",
        "white"
      ]
    },
    "tintSteps": [
      8,
      16,
      32,
      64
    ]
  },
  "roles": {
    "surface": "canvas",
    "surface-raised": "white",
    "surface-inverse": "navy",
    "text": "text",
    "text-muted": "muted",
    "text-inverse": "white",
    "primary": "navy",
    "on-primary": "white",
    "accent": "teal",
    "accent-ink": "tealInk",
    "highlight": "amber",
    "highlight-ink": "amberInk",
    "success": "success",
    "error": "error",
    "focus": "navy",
    "focus-on-dark": "amber",
    "border": "text@20"
  },
  "contrastPairs": [
    {
      "fg": "text",
      "bg": "canvas",
      "min": 4.5,
      "use": "body copy on the page"
    },
    {
      "fg": "text",
      "bg": "white",
      "min": 4.5,
      "use": "body copy on a card"
    },
    {
      "fg": "muted",
      "bg": "canvas",
      "min": 4.5,
      "use": "secondary text on the page"
    },
    {
      "fg": "muted",
      "bg": "white",
      "min": 4.5,
      "use": "secondary text on a card"
    },
    {
      "fg": "navy",
      "bg": "canvas",
      "min": 4.5,
      "use": "headings on the page"
    },
    {
      "fg": "navy",
      "bg": "white",
      "min": 4.5,
      "use": "headings on a card"
    },
    {
      "fg": "tealInk",
      "bg": "canvas",
      "min": 4.5,
      "use": "teal text and links on the page"
    },
    {
      "fg": "tealInk",
      "bg": "white",
      "min": 4.5,
      "use": "teal text and links on a card"
    },
    {
      "fg": "amberInk",
      "bg": "white",
      "min": 4.5,
      "use": "amber-toned text on a card"
    },
    {
      "fg": "white",
      "bg": "navy",
      "min": 4.5,
      "use": "text on a navy surface or button"
    },
    {
      "fg": "white",
      "bg": "tealInk",
      "min": 4.5,
      "use": "text on a teal button"
    },
    {
      "fg": "amber",
      "bg": "navy",
      "min": 4.5,
      "use": "accent text on navy (stars, XP)"
    },
    {
      "fg": "navy",
      "bg": "amber",
      "min": 4.5,
      "use": "text on an amber fill"
    },
    {
      "fg": "success",
      "bg": "white",
      "min": 4.5,
      "use": "success text on a card"
    },
    {
      "fg": "error",
      "bg": "white",
      "min": 4.5,
      "use": "error text on a card"
    },
    {
      "fg": "navy",
      "bg": "white",
      "min": 3,
      "use": "focus ring on a light surface (non-text)"
    },
    {
      "fg": "amber",
      "bg": "navy",
      "min": 3,
      "use": "focus ring on a navy surface (non-text)"
    }
  ],
  "type": {
    "families": {
      "display": "\"Baloo 2\", \"Arial Rounded MT Bold\", \"Avenir Next\", sans-serif",
      "body": "\"Nunito\", \"Avenir Next\", Calibri, system-ui, sans-serif",
      "support": "\"Atkinson Hyperlegible\", \"Nunito\", system-ui, sans-serif",
      "math": "\"Nunito\", \"Avenir Next\", Calibri, system-ui, sans-serif"
    },
    "ratio": 1.2,
    "basePx": 18,
    "minPx": 13,
    "scale": {
      "label": 0.8125,
      "caption": 0.9375,
      "body": 1.125,
      "lead": 1.35,
      "title-3": 1.625,
      "title-2": 1.95,
      "title-1": 2.35
    },
    "lineHeight": {
      "body": 1.55,
      "heading": 1.2,
      "tight": 1.3
    },
    "weights": {
      "regular": 400,
      "semibold": 600,
      "bold": 700
    },
    "measureCh": {
      "min": 55,
      "max": 75
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pill": 999
  },
  "elevation": {
    "none": "none",
    "raised": "0 1px 2px rgba(23, 50, 77, 0.08), 0 2px 6px rgba(23, 50, 77, 0.06)",
    "floating": "0 6px 18px -6px rgba(23, 50, 77, 0.22)"
  },
  "motion": {
    "fastMs": 150,
    "baseMs": 200,
    "slowMs": 250,
    "celebrateMs": 600,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "target": {
    "minPx": 44
  },
  "forbiddenPairs": [
    {
      "fg": "teal",
      "bg": "white",
      "why": "brand teal is a FILL; as text or a required outline on white it misses 3:1. Use tealInk."
    },
    {
      "fg": "teal",
      "bg": "canvas",
      "why": "same: use tealInk for text and outlines."
    },
    {
      "fg": "white",
      "bg": "teal",
      "why": "white text on the brand teal fill misses 4.5:1. Use white on tealInk, or navy on teal."
    },
    {
      "fg": "amber",
      "bg": "white",
      "why": "amber is a FILL or a mark on navy; amber text on white is unreadable. Use amberInk."
    },
    {
      "fg": "amber",
      "bg": "canvas",
      "why": "same: use amberInk."
    }
  ]
}
